   "outputs": [],
   "source": [
    "y = np.where(Y <= 0, -1, 1).astype(int)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "cad551b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "6bc42bff",
   "metadata": {},
   "outputs": [],
   "source": [
    "n = X.shape[0]\n",
    "C = 1.0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "1b299f25",
   "metadata": {},
   "outputs": [],
   "source": [
    "from cvxopt import matrix, solvers\n",
    "\n",
    "# Gram matrix using Linear Inner Product: X_i^T * X_j\n",
    "P = matrix(np.outer(y, y) * np.dot(X_scaled, X_scaled.T))\n",
    "q = matrix(-np.ones(n))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "23214e13",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Bounds constraints: 0 <= alpha_i <= C\n",
    "# Expressed as: -alpha_i <= 0 AND alpha_i <= C\n",
    "G = matrix(np.vstack((-np.eye(n), np.eye(n))))\n",
    "h = matrix(np.hstack((np.zeros(n), (np.ones(n) * C))))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "1308ffa2",
   "metadata": {},
   "outputs": [],
