    "xB, yB = 2, 5\n",
    "\n",
    "# Plot line segment connecting Point A and Point B\n",
    "ax2.plot(\n",
    "    [xA, xB],\n",
    "    [yA, yB],\n",
    "    \"r--\",\n",
    "    linewidth=2,\n",
    "    label=\"Segment AB (100% Overlapped on the line)\",\n",
    ")\n",
    "\n",
